			<param name="ino" type="ulong"/>
			<param name="fileName" type="string"/>
			<param name="count" type="ulong"/>
			<!-- using 'ino=' below helps when grepping through logs -->
			<![CDATA[Inode ino={ino} (file '{fileName}') reference count increased to {count}.]]>
		</message>
